 "claim": "Development measurement of raw SECURITY_HARDCODED_SECRET candidates added by the positional credential sensor. Not a held-out precision or recall score.",
 "claim_boundary": {
  "held_out": false,
  "human_validation": false,
  "tier_effect": "none; every added alert is tiered NEEDS_CONTEXT like existing hardcoded-secret alerts",
  "exposure": "The vulnerable-app repositories were inspected while the configuration-slot and stored-hash rules were written, so their counts are exposed development evidence.",
  "labels": "One AI reviewer read every added alert in source. No second reviewer and no credential validity checks.",
  "method": "Sensor functions were run directly over each parsed Python file (factoryline.provenance.positional_credential_findings and literal_credential_candidate). The pre-change count is the previous NAME = literal eligibility rule, before downstream source-bound exclusions. Full native scans of two vulnerable apps and three control repositories were compared separately."
 },
 "rules": {
  "recognized_key_format": "literal matching factory.context_efficiency._SECRET_BYTES in any expression position",
  "configuration_slot": "non-placeholder literal written to <app>.secret_key, <x>.config[UPPER_CREDENTIAL_KEY] or <x>.config.update/from_mapping(UPPER_CREDENTIAL_KEY=...)",
  "generated_shape": "credential-named attribute, keyword or mapping slot whose value has an alphanumeric run switching between letters and digits at least three times; stored password hashes excluded",
  "token_name_generated_shape": "NAME = literal where NAME is a token/passwd/pwd/auth_key word and the value is generated-shaped"
 },
