<idea-plugin url="https://github.com/zrk222/code-factory">
    <id>app.factoryline</id>
    <name>FactoryLine AI Proof</name>
    <vendor email="rkatz22@gmail.com" url="https://github.com/zrk222/code-factory">FactoryLine</vendor>
    <description><![CDATA[
<h3>Review AI changes with evidence in view</h3>
<p>FactoryLine connects code changes, audit findings, tests, and repair candidates to local, source-bound receipts.</p>
<h4>What's improved in 1.3.3</h4>
<ul>
<li>Wait for pending saved-file VFS writes before local commands read disk.</li>
<li>Start Studio in the background and block launch when preparation fails.</li>
<li>Preserve the 2025.2 platform baseline and compatibility with newer IDEs.</li>
</ul>
<h4>Start in your repository</h4>
<p>Run <code>factory guide</code>, then <code>factory scan --root .</code>. Use Graph Ops to inspect evidence and choose the next action.</p>
<p>The plugin uses your separately configured local FactoryLine runtime. Junie is optional. You control applying changes, merging, and publishing. Checks are bounded and do not certify a repository.</p>
<p><a href="https://github.com/zrk222/code-factory">Documentation</a> | <a href="https://github.com/zrk222/code-factory/issues">Report an issue</a></p>
    ]]></description>
    <change-notes><![CDATA[
<p><strong>1.3.3:</strong> Keep saved workspace files consistent before local commands read disk.</p>
<ul>
<li>Flush pending VFS writes on supporting IDEs; block launch when preparation fails.</li>
<li>Start Studio in the background, keep callbacks on EDT, and clean up failed startup.</li>
<li>Preserve the 2025.2 baseline. Unsaved editor buffers remain untouched; the local FactoryLine runtime is configured separately.</li>
</ul>
<p><a href="https://github.com/zrk222/code-factory/blob/main/editors/intellij/CHANGELOG.md">Earlier release notes</a></p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="app.factoryline.intellij.FactoryLineSettings"/>
        <applicationConfigurable instance="app.factoryline.intellij.FactoryLineSettingsConfigurable"
                               displayName="FactoryLine" parentId="tools"/>
        <toolWindow id="FactoryLine"
                    anchor="right"
                    factoryClass="app.factoryline.intellij.FactoryLineToolWindowFactory"/>
        <notificationGroup id="FactoryLine" displayType="BALLOON" isLogByDefault="false"/>
        <codeInsight.lineMarkerProvider language="ANY"
                                        implementationClass="app.factoryline.intellij.FactoryLineRequirementLineMarkerProvider"/>
    </extensions>

    <actions>
        <group id="app.factoryline.intellij.actions" text="FactoryLine" description="Run local FactoryLine commands">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="app.factoryline.intellij.firstProof"
                    class="app.factoryline.intellij.RunFirstProofAction"
                    text="Run First Proof"
                    description="Check the local Code Factory setup and show machine-readable results"/>
            <action id="app.factoryline.intellij.assemble"
                    class="app.factoryline.intellij.RunAssemblyAction"
                    text="Run Spec-to-Ship Assembly"
                    description="Run FactoryLine assembly for a feature"/>
            <action id="app.factoryline.intellij.continue"
                    class="app.factoryline.intellij.ContinueAssemblyAction"
                    text="Continue Assembly to Next Boundary"
                    description="Resume FactoryLine from the next safe stage"/>
            <action id="app.factoryline.intellij.verify"
                    class="app.factoryline.intellij.VerifyReceiptsAction"
                    text="Verify Feature Receipts"
                    description="Verify FactoryLine receipts for a feature"/>
            <action id="app.factoryline.intellij.openReceipt"
                    class="app.factoryline.intellij.OpenLatestReceiptAction"
                    text="Open Latest Receipt"
                    description="Show the newest local FactoryLine receipt"/>
            <action id="app.factoryline.intellij.openMeter"
                    class="app.factoryline.intellij.OpenMeterAction"
                    text="Open Local Meter"
                    description="Show the local FactoryLine time and token meter"/>
            <action id="app.factoryline.intellij.openSavings"
                    class="app.factoryline.intellij.OpenSavingsAction"
                    text="Open Paired Savings Report"
                    description="Show exact baseline-versus-Factory savings without inferred values"/>
            <action id="app.factoryline.intellij.openStudio"
                    class="app.factoryline.intellij.OpenStudioAction"
                    text="Open Local Factory Studio"
                    description="Start the loopback-only governed target builder"/>
            <action id="app.factoryline.intellij.openProductMissions"
                    class="app.factoryline.intellij.OpenProductMissionsAction"
                    text="Open Product Missions"
                    description="Compile a PRD into supervised, passport-bound value missions"/>
            <action id="app.factoryline.intellij.openGraphOps"
                    class="app.factoryline.intellij.OpenGraphOpsAction"
                    text="Open Unified Graph Ops"
                    description="Inspect the local evidence graph without executing or approving work"/>
            <action id="app.factoryline.intellij.missionOperations"
                    class="app.factoryline.intellij.MissionOperationsAction"
                    text="Mission Graph &amp; Provider Operations"
                    description="Operate durable mission graphs and route a secret-free BYOK policy"/>
            <action id="app.factoryline.intellij.analyzeChangedProof"
                    class="app.factoryline.intellij.AnalyzeChangedProofAction"
                    text="Analyze Changed Proof"
                    description="Show FactoryLine receipt invalidation caused by current changes"/>
            <action id="app.factoryline.intellij.analyzeWorkspaceAdvisor"
                    class="app.factoryline.intellij.AnalyzeWorkspaceAdvisorAction"
                    text="Analyze Workspace Load and Remote/WSL Preflight"
                    description="Measure bounded local workspace shape without changing IDE, cache, index, or remote settings"/>
            <action id="app.factoryline.intellij.openIdeHealth"
                    class="app.factoryline.intellij.OpenIdeHealthAction"
                    text="Open IDE Health Flight Recorder"
                    description="Record bounded local aggregate runtime observations without changing IDE configuration"/>
            <action id="app.factoryline.intellij.openGuardian"
                    class="app.factoryline.intellij.OpenGuardianAction"
                    text="Open Guardian Core"
                    description="Review local IDE observations and open safe proof routes without executing a command"/>
            <action id="app.factoryline.intellij.openAppForge"
                    class="app.factoryline.intellij.OpenAppForgeAction"
                    text="Open AppForge Mission Control"
                    description="Inspect local iOS design and submission evidence without accessing credentials or submitting to Apple"/>
            <action id="app.factoryline.intellij.captureIndexContinuityBaseline"
                    class="app.factoryline.intellij.CaptureIndexContinuityBaselineAction"
                    text="Capture Index Continuity Baseline"
                    description="Save an explicit local structural baseline without changing IDE state"/>
            <action id="app.factoryline.intellij.compareIndexContinuityBaseline"
                    class="app.factoryline.intellij.CompareIndexContinuityBaselineAction"
                    text="Compare Index Continuity Baseline"
                    description="Compare current local structure with the saved baseline without changing IDE state"/>
            <action id="app.factoryline.intellij.reviewCurrentDiff"
                    class="app.factoryline.intellij.ReviewCurrentDiffAction"
                    text="Review Current Diff"
                    description="Map the local diff to exact proof gaps without applying or publishing changes"/>
            <action id="app.factoryline.intellij.prepareRepairScope"
                    class="app.factoryline.intellij.PrepareRepairScopeAction"
                    text="Prepare Verified Repair Sandbox"
                    description="Seal one native Change List and create a local repair scope without applying changes"/>
            <action id="app.factoryline.intellij.inspectIntentLedger"
                    class="app.factoryline.intellij.InspectIntentLedgerAction"
                    text="Inspect Change List Intent"
                    description="Read one native Change List's local behavioral contract and proof state without executing work"/>
            <action id="app.factoryline.intellij.captureIntentLedger"
                    class="app.factoryline.intellij.CaptureIntentLedgerAction"
                    text="Capture Change List Intent"
                    description="Save a named, explicit local behavioral contract for one native Change List"/>
            <action id="app.factoryline.intellij.reviewCurrentFile"
                    class="app.factoryline.intellij.ReviewCurrentFileAction"
                    text="Review This File"
                    description="Focus a local proof review on the active project file"/>
            <action id="app.factoryline.intellij.checkReceiptSignature"
                    class="app.factoryline.intellij.CheckLatestReceiptSignatureAction"
                    text="Check Latest Receipt Signature State"
                    description="Show signature presence without claiming identity verification"/>
        </group>
    </actions>
</idea-plugin>
