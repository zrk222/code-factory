{
  "name": "factoryline-vscode",
  "displayName": "FactoryLine",
  "description": "Trace AI changes from intent through six audits to reviewable proof and a human-owned release decision.",
  "version": "1.1.2",
  "publisher": "zrk222",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrk222/code-factory.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Audit execution requires Workspace Trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "FactoryLine executes local tools in a filesystem workspace."
    }
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "code-factory",
    "receipts",
    "verification",
    "testing",
    "mvp",
    "mcp",
    "graph-ops",
    "proof-debt",
    "ai-governance",
    "design-review",
    "ui-quality",
    "prd-grill",
    "independent-verification",
    "verifier-plane",
    "proofsearch",
    "counterfactual-repair",
    "first-lap",
    "holdout-testing",
    "verifier-calibration"
  ],
  "activationEvents": [
    "onView:factorylineEvidence",
    "onCommand:factoryline.auditWorkspace",
    "onCommand:factoryline.copyAuditSummary",
    "onCommand:factoryline.assemble",
    "onCommand:factoryline.continue",
    "onCommand:factoryline.verify",
    "onCommand:factoryline.openMeter",
    "onCommand:factoryline.openSavings",
    "onCommand:factoryline.openLatestReceipt",
    "onCommand:factoryline.openStudio",
    "onCommand:factoryline.openProductMissions",
    "onCommand:factoryline.openGraphOps",
    "onCommand:factoryline.openRequirementEvidence"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "factorylineEvidence",
          "name": "FactoryLine Evidence"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "factoryline.auditWorkspace",
          "when": "view == factorylineEvidence",
          "group": "navigation"
        },
        {
          "command": "factoryline.copyAuditSummary",
          "when": "view == factorylineEvidence",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "factoryline.auditWorkspace",
        "title": "FactoryLine: Run CF + ForgeLine Audits",
        "icon": "$(beaker)"
      },
      {
        "command": "factoryline.copyAuditSummary",
        "title": "FactoryLine: Copy CF + ForgeLine Summary",
        "icon": "$(copy)"
      },
      {
        "command": "factoryline.assemble",
        "title": "FactoryLine: Run Spec-to-Ship Assembly"
      },
      {
        "command": "factoryline.continue",
        "title": "FactoryLine: Continue Assembly to Next Boundary"
      },
      {
        "command": "factoryline.verify",
        "title": "FactoryLine: Verify Feature Receipts"
      },
      {
        "command": "factoryline.openMeter",
        "title": "FactoryLine: Open Local Meter"
      },
      {
        "command": "factoryline.openSavings",
        "title": "FactoryLine: Open Paired Savings Report"
      },
      {
        "command": "factoryline.openLatestReceipt",
        "title": "FactoryLine: Open Latest Receipt"
      },
      {
        "command": "factoryline.openStudio",
        "title": "FactoryLine: Open Local Factory Studio"
      },
      {
        "command": "factoryline.openProductMissions",
        "title": "FactoryLine: Open Product Missions"
      },
      {
        "command": "factoryline.openGraphOps",
        "title": "FactoryLine: Open Unified Graph Ops"
      },
      {
        "command": "factoryline.openRequirementEvidence",
        "title": "FactoryLine: Open Requirement Evidence"
      }
    ],
    "configuration": {
      "title": "FactoryLine",
      "properties": {
        "factoryline.command": {
          "type": "string",
          "default": "factory",
          "description": "FactoryLine CLI command or absolute executable path."
        },
        "factoryline.forgeCommand": {
          "type": "string",
          "default": "forge",
          "description": "ForgeLine CLI executable for repository inventory. Arguments are fixed by the extension."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/bundle.mjs",
    "test": "node --test scripts/audit-lockfile.test.mjs && node --test ../proof-client/test/client.test.cjs && npm run compile && node ./dist/test/receipt.test.js",
    "audit": "node scripts/audit-lockfile.mjs",
    "package": "npm run test && vsce package --no-dependencies"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@factoryline/proof-client": "file:../proof-client",
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.8.3"
  }
}
