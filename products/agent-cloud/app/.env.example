VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# Set these in the Convex deployment environment, not in browser-hosted secrets.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-spa-client-id

# Production-only control-plane references. Values are validated without being printed.
AGENT_OVEN_APP_URL=https://app.example.com
AGENT_OVEN_BILLING_WEBHOOK_SECRET_REF=vault://agent-oven/billing-webhook
AGENT_OVEN_EMAIL_CONNECTION_REF=vault://agent-oven/transactional-email
AGENT_OVEN_RUNTIME_WORKER_SECRET_REF=vault://agent-oven/runtime-worker
AGENT_OVEN_BACKUP_STORAGE_REF=vault://agent-oven/backup-storage
AGENT_OVEN_SECURITY_CONTACT=security@example.com
