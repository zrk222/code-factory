+    private int nativeNextInvocation(Plugin plugin) {
+        return nativeInvocationSequence
+                .computeIfAbsent(plugin.getId(), ignored -> new AtomicInteger())
+                .incrementAndGet();
+    }
+
+    private void runTrackedPlugin(Plugin plugin, Plugin test, int invocation) {
+        int pluginId = plugin.getId();
+        nativeInvocationActive
+                .computeIfAbsent(pluginId, ignored -> new AtomicInteger())
+                .incrementAndGet();
+        nativeInvocationStarted
+                .computeIfAbsent(pluginId, ignored -> new AtomicInteger())
+                .incrementAndGet();
+        try {
+            NativeRuleLedger.record(this, plugin, invocation, "invocation_started", null, null);
+        } catch (RuntimeException e) {
+            stop();
+            nativeInvocationActive.get(pluginId).decrementAndGet();
+            throw e;
+        }
+
+        Throwable failure = null;
+        try {
+            test.run();
+        } catch (RuntimeException | Error e) {
+            failure = e;
+            nativePluginFailures.add(pluginId);
+            nativeInvocationFailed
+                    .computeIfAbsent(pluginId, ignored -> new AtomicInteger())
+                    .incrementAndGet();
+        }
+
+        try {
+            if (failure == null) {
+                nativeInvocationReturned
+                        .computeIfAbsent(pluginId, ignored -> new AtomicInteger())
+                        .incrementAndGet();
+                NativeRuleLedger.record(
+                        this, plugin, invocation, "invocation_returned", null, null);
+            } else {
+                NativeRuleLedger.record(
+                        this,
+                        plugin,
+                        invocation,
+                        "invocation_failed",
+                        failure.getClass().getName(),
+                        null);
+            }
+        } catch (RuntimeException e) {
+            stop();
+            if (failure != null) {
+                failure.addSuppressed(e);
+            } else {
+                failure = e;
+            }
+        } finally {
+            nativeInvocationActive.get(pluginId).decrementAndGet();
+            maybeRecordNativePluginTerminal(plugin);
+        }
+        if (failure instanceof Error) {
+            throw (Error) failure;
+        }
+        if (failure instanceof RuntimeException) {
+            throw (RuntimeException) failure;
+        }
+    }
+
+    private void maybeRecordNativePluginTerminal(Plugin plugin) {
+        int pluginId = plugin.getId();
+        if (!nativeCompletionRequested.contains(pluginId)
+                || nativeInvocationActive
+                                .computeIfAbsent(pluginId, ignored -> new AtomicInteger())
+                                .get()
+                        != 0
+                || !nativePluginTerminals.add(pluginId)) {
+            return;
+        }
+        PluginStats stats = mapPluginStats.get(pluginId);
+        String event;
+        String failureClass = null;
+        if (stats != null && stats.isSkipped()) {
+            event = "plugin_skipped";
+        } else if (isStop()) {
+            event = "plugin_stopped";
+        } else if (nativePluginFailures.contains(pluginId)
+                || nativeInvocationStarted.getOrDefault(pluginId, new AtomicInteger()).get() == 0
+                || nativeInvocationReturned.getOrDefault(pluginId, new AtomicInteger()).get()
+                        != nativeInvocationStarted.getOrDefault(pluginId, new AtomicInteger()).get()) {
+            event = "plugin_failed";
+        } else {
+            event = "plugin_completed";
+        }
+        NativeRuleLedger.record(this, plugin, 0, event, failureClass, stats);
+    }
+
+    private void recordUnscheduledNativePlugins() {
+        if (!NativeRuleLedger.enabled()) {
+            return;
+        }
+        for (Plugin plugin : pluginFactory.getPending()) {
+            recordNativePluginEnd(plugin, isStop() ? "plugin_stopped" : "plugin_failed");
+        }
+        for (Plugin plugin : pluginFactory.getRunning()) {
+            recordNativePluginEnd(plugin, isStop() ? "plugin_stopped" : "plugin_failed");
+        }
+        for (Plugin plugin : pluginFactory.getCompleted()) {
+            if (!nativePluginTerminals.contains(plugin.getId())) {
+                recordNativePluginEnd(plugin, "plugin_failed");
+            }
+        }
+    }
+
+    private void recordNativePluginEnd(Plugin plugin, String event) {
+        if (!nativePluginTerminals.add(plugin.getId())) {
+            return;
+        }
+        NativeRuleLedger.record(
+                this, plugin, 0, event, null, mapPluginStats.get(plugin.getId()));
+    }
