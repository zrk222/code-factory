+    private static final class NativeRuleLedger {
+
+        private static final String ENV_ENABLED = "FACTORY_ZAP_LEDGER_ENABLED";
+        private static final String ENV_RUN_ID = "FACTORY_RUN_ID";
+        private static final String ENV_CANDIDATE = "FACTORY_CANDIDATE_SHA256";
+        private static final String ENV_PROFILE = "FACTORY_PROFILE_SHA256";
+        private static final Path OUTPUT_DIR = Paths.get("/out");
+        private static final Path OUTPUT = OUTPUT_DIR.resolve("zap-rule-ledger.jsonl");
+        private static final long MAX_BYTES = 4 * 1024 * 1024;
+        private static final int MAX_RECORD_BYTES = 4096;
+
+        private static boolean initialized;
+        private static boolean enabled;
+        private static String runId;
+        private static String candidateSha256;
+        private static String profileSha256;
+        private static FileChannel channel;
+        private static long writtenBytes;
+
+        private NativeRuleLedger() {}
+
+        private static synchronized void begin() {
+            if (initialized) {
+                return;
+            }
+            String requested = System.getenv(ENV_ENABLED);
+            if (requested == null || requested.isEmpty() || "0".equals(requested)) {
+                initialized = true;
+                return;
+            }
+            if (!"1".equals(requested)) {
+                throw new IllegalStateException("invalid native rule-ledger enable flag");
+            }
+            runId = requiredEnv(ENV_RUN_ID, "[A-Za-z0-9._-]{1,128}");
+            candidateSha256 = requiredEnv(ENV_CANDIDATE, "[0-9a-f]{64}");
+            profileSha256 = requiredEnv(ENV_PROFILE, "[0-9a-f]{64}");
+            try {
+                if (!Files.isDirectory(OUTPUT_DIR, LinkOption.NOFOLLOW_LINKS)
+                        || Files.isSymbolicLink(OUTPUT_DIR)
+                        || !OUTPUT_DIR.toRealPath(LinkOption.NOFOLLOW_LINKS).equals(OUTPUT_DIR)) {
+                    throw new IllegalStateException("native rule-ledger output directory invalid");
+                }
+                if (Files.exists(OUTPUT, LinkOption.NOFOLLOW_LINKS)) {
+                    throw new IllegalStateException("native rule-ledger output already exists");
+                }
+                channel = FileChannel.open(
+                        OUTPUT,
+                        StandardOpenOption.CREATE_NEW,
+                        StandardOpenOption.WRITE,
+                        LinkOption.NOFOLLOW_LINKS);
+            } catch (IOException e) {
+                throw new IllegalStateException("native rule-ledger output unavailable", e);
+            }
+            enabled = true;
+            initialized = true;
+        }
+
+        private static String requiredEnv(String name, String pattern) {
+            String value = System.getenv(name);
+            if (value == null || !value.matches(pattern)) {
+                throw new IllegalStateException("invalid native rule-ledger binding: " + name);
+            }
+            return value;
+        }
+
+        private static synchronized boolean enabled() {
+            return enabled;
+        }
+
+        private static synchronized void record(
+                HostProcess owner,
+                Plugin plugin,
+                int invocation,
+                String event,
+                String exceptionClass,
+                PluginStats stats) {
+            if (!enabled) {
+                return;
+            }
+            String hostId = sha256(owner.hostAndPort.getBytes(StandardCharsets.UTF_8));
+            StringBuilder json = new StringBuilder(512);
+            json.append("{\"schema\":\"factory.zap-rule-ledger.v1\"")
+                    .append(",\"run_id\":").append(jsonString(runId))
+                    .append(",\"candidate_sha256\":").append(jsonString(candidateSha256))
+                    .append(",\"profile_sha256\":").append(jsonString(profileSha256))
+                    .append(",\"host_id\":").append(jsonString(hostId))
+                    .append(",\"plugin_id\":").append(plugin.getId())
+                    .append(",\"plugin_name\":")
+                    .append(jsonString(safePluginName(plugin.getCodeName())))
+                    .append(",\"invocation\":").append(invocation)
+                    .append(",\"event\":").append(jsonString(event))
+                    .append(",\"status\":").append(jsonString(status(event)));
+            PluginStats recordStats = stats == null ? owner.mapPluginStats.get(plugin.getId()) : stats;
+            json.append(",\"message_count\":")
+                    .append(recordStats == null ? 0 : recordStats.getMessageCount())
+                    .append(",\"alert_count\":")
+                    .append(recordStats == null ? 0 : recordStats.getAlertCount());
+            if ("invocation_failed".equals(event)) {
+                json.append(",\"exception_class\":")
+                        .append(jsonString(exceptionClass));
+            }
+            json.append("}\n");
+            byte[] raw = json.toString().getBytes(StandardCharsets.UTF_8);
+            if (raw.length > MAX_RECORD_BYTES || writtenBytes + raw.length > MAX_BYTES) {
+                throw new IllegalStateException("native rule-ledger byte budget exceeded");
+            }
+            try {
+                ByteBuffer buffer = ByteBuffer.wrap(raw);
+                while (buffer.hasRemaining()) {
+                    channel.write(buffer);
+                }
+                channel.force(false);
+                writtenBytes += raw.length;
+            } catch (IOException e) {
+                throw new IllegalStateException("native rule-ledger write failed", e);
+            }
+        }
+
+        private static String status(String event) {
+            return event.substring(event.indexOf('_') + 1);
+        }
+
+        private static String safePluginName(String name) {
+            if (name == null || name.isEmpty()) {
+                return "unknown";
+            }
+            StringBuilder result = new StringBuilder(Math.min(name.length(), 128));
+            for (int i = 0; i < name.length() && result.length() < 128; i++) {
+                char ch = name.charAt(i);
+                result.append((ch >= 'A' && ch <= 'Z')
+                                || (ch >= 'a' && ch <= 'z')
+                                || (ch >= '0' && ch <= '9')
+                                || ch == '.'
+                                || ch == '_'
+                                || ch == '-'
+                        ? ch
+                        : '_');
+            }
+            return result.toString();
+        }
+
+        private static String jsonString(String value) {
+            StringBuilder result = new StringBuilder(value.length() + 2).append('"');
+            for (int i = 0; i < value.length(); i++) {
+                char ch = value.charAt(i);
+                if (ch == '"' || ch == '\\') {
+                    result.append('\\').append(ch);
+                } else if (ch < 0x20) {
+                    result.append(String.format("\\u%04x", (int) ch));
+                } else {
+                    result.append(ch);
+                }
+            }
+            return result.append('"').toString();
+        }
+
+        private static String sha256(byte[] raw) {
+            try {
+                byte[] hash = MessageDigest.getInstance("SHA-256").digest(raw);
+                StringBuilder result = new StringBuilder(64);
+                for (byte value : hash) {
+                    result.append(String.format("%02x", value & 0xff));
+                }
+                return result.toString();
+            } catch (NoSuchAlgorithmException e) {
+                throw new IllegalStateException("SHA-256 unavailable", e);
+            }
+        }
+    }
+
+    static boolean isNativeRuleLedgerEnabled() {
+        return NativeRuleLedger.enabled();
+    }
