@@ -0,0 +1,87 @@
+package detect
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/zricethezav/gitleaks/v8/config"
+	"github.com/zricethezav/gitleaks/v8/regexp"
+)
+
+func TestFactoryLedgerBypassesKeywordPrefilterAndRedactsContent(t *testing.T) {
+	parent := t.TempDir()
+	root := filepath.Join(parent, "source")
+	require.NoError(t, os.Mkdir(root, 0700))
+	configPath := filepath.Join(root, "config.toml")
+	require.NoError(t, os.WriteFile(configPath, []byte("[config]\n"), 0600))
+	sourcePath := filepath.Join(root, "source.txt")
+	require.NoError(t, os.WriteFile(sourcePath, []byte("CANARYSECRET123"), 0600))
+	ledgerPath := filepath.Join(parent, "ledger.json")
+	detector := NewDetector(config.Config{Rules: map[string]config.Rule{
+		"fixture-rule": {RuleID: "fixture-rule", Regex: regexp.MustCompile("CANARYSECRET[0-9]+"), Keywords: []string{"absent-keyword"}},
+	}})
+	detector.Config.Path = configPath
+	detector.FactoryLedger = NewFactoryRuleLedger(root, ledgerPath, "a"+strings.Repeat("0", 63))
+	findings := detector.Detect(Fragment{FilePath: sourcePath, Raw: "CANARYSECRET123"})
+	require.Len(t, findings, 1)
+	require.NoError(t, detector.FactoryLedger.Write(configPath, true))
+	data, err := os.ReadFile(ledgerPath)
+	require.NoError(t, err)
+	require.NotContains(t, string(data), "CANARYSECRET123")
+	var doc factoryRuleDocument
+	require.NoError(t, json.Unmarshal(data, &doc))
+	require.False(t, doc.Overflow)
+	require.Len(t, doc.Rows, 1)
+	require.Equal(t, "source.txt", doc.Rows[0].Path)
+	require.Equal(t, "fixture-rule", doc.Rows[0].RuleID)
+	require.EqualValues(t, 1, doc.Rows[0].Counts["regex_executed"])
+	require.EqualValues(t, 1, doc.Rows[0].Counts["attempted"])
+	require.EqualValues(t, 1, doc.Rows[0].Counts["finding"])
+	require.True(t, doc.Complete)
+	require.Equal(t, "adapter_candidate_sha256", doc.SourceIdentityKind)
+}
+
+func TestFactoryLedgerRefusesDestinationInsideSourceBeforeWriting(t *testing.T) {
+	parent := t.TempDir()
+	root := filepath.Join(parent, "source")
+	require.NoError(t, os.Mkdir(root, 0700))
+	configPath := filepath.Join(parent, "config.toml")
+	require.NoError(t, os.WriteFile(configPath, []byte("[config]\n"), 0600))
+	destination := filepath.Join(root, "ledger.json")
+	ledger := NewFactoryRuleLedger(root, destination, strings.Repeat("d", 64))
+	require.Error(t, ledger.Write(configPath, true))
+	_, err := os.Lstat(destination)
+	require.Error(t, err)
+}
+
+func TestFactoryLedgerMarksOutOfRootPathInvalid(t *testing.T) {
+	parent := t.TempDir()
+	root := filepath.Join(parent, "source")
+	require.NoError(t, os.Mkdir(root, 0700))
+	ledger := NewFactoryRuleLedger(root, filepath.Join(parent, "ledger.json"), strings.Repeat("b", 64))
+	ledger.Record(filepath.Join(filepath.Dir(root), "outside.txt"), "rule", "attempted")
+	require.EqualValues(t, 1, ledger.invalidPaths)
+	require.Empty(t, ledger.rows)
+}
+
+func TestFactoryLedgerRejectsSymlinkEscape(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation may require elevated privileges on Windows")
+	}
+	parent := t.TempDir()
+	root := filepath.Join(parent, "source")
+	require.NoError(t, os.Mkdir(root, 0700))
+	outside := filepath.Join(parent, "outside.txt")
+	require.NoError(t, os.WriteFile(outside, []byte("x"), 0600))
+	link := filepath.Join(root, "linked.txt")
+	require.NoError(t, os.Symlink(outside, link))
+	ledger := NewFactoryRuleLedger(root, filepath.Join(parent, "ledger.json"), strings.Repeat("c", 64))
+	ledger.Record(link, "rule", "attempted")
+	require.EqualValues(t, 1, ledger.invalidPaths)
+	require.Empty(t, ledger.rows)
+}
