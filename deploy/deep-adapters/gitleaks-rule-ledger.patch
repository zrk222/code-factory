diff --git a/detect/factory_ledger.go b/detect/factory_ledger.go
new file mode 100644
index 0000000..747aafe
--- /dev/null
+++ b/detect/factory_ledger.go
@@ -0,0 +1,214 @@
+package detect
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"math"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+)
+
+const (
+	factoryLedgerMaxRows  = 200_000
+	factoryLedgerMaxPath  = 2048
+	factoryLedgerMaxRule  = 256
+	factoryLedgerMaxBytes = 8 << 20
+)
+
+var factoryLedgerDigest = regexp.MustCompile(`^[a-f0-9]{64}$`)
+
+var factoryLedgerDispositions = map[string]bool{
+	"attempted": true, "suppressed_skip_report": true,
+	"suppressed_rule_allowlist": true, "suppressed_global_allowlist": true,
+	"path_evaluated": true, "not_applicable_path_mismatch": true,
+	"not_applicable_no_regex": true, "not_run_size_limit": true,
+	"regex_executed": true, "regex_match": true, "finding": true,
+}
+
+// FactoryRuleLedger is optional instrumentation for the isolated Code Factory
+// worker. It records rule IDs, relative paths, and counters only; never matches.
+type FactoryRuleLedger struct {
+	Root string
+	Path string
+	// SourceSHA256 is supplied by the trusted CF adapter after inventory hashing.
+	// The native binary does not independently compute this whole-tree identity.
+	SourceSHA256 string
+	Complete     bool
+	mu           sync.Mutex
+	rows         map[string]*factoryRuleRow
+	rowBytes     int
+	overflow     bool
+	invalidPaths uint64
+}
+
+type factoryRuleRow struct {
+	Path   string            `json:"path"`
+	RuleID string            `json:"rule_id"`
+	Counts map[string]uint64 `json:"counts"`
+}
+
+type factoryRuleDocument struct {
+	Schema             string            `json:"schema"`
+	RootSHA256         string            `json:"root_sha256"`
+	SourceIdentityKind string            `json:"source_identity_kind"`
+	SourceSHA256       string            `json:"source_sha256"`
+	ConfigSHA256       string            `json:"config_sha256"`
+	PrefilterBypassed  bool              `json:"prefilter_bypassed"`
+	Complete           bool              `json:"complete"`
+	Overflow           bool              `json:"overflow"`
+	InvalidPaths       uint64            `json:"invalid_paths"`
+	Rows               []*factoryRuleRow `json:"rows"`
+}
+
+// NewFactoryRuleLedger creates an empty bounded recorder for one directory scan.
+func NewFactoryRuleLedger(root, path, sourceSHA256 string) *FactoryRuleLedger {
+	return &FactoryRuleLedger{Root: root, Path: path, SourceSHA256: sourceSHA256, rows: make(map[string]*factoryRuleRow)}
+}
+
+// Record adds one secret-free native disposition for a rule and source path.
+func (l *FactoryRuleLedger) Record(sourcePath, ruleID, disposition string) {
+	if l == nil {
+		return
+	}
+	root, err := filepath.EvalSymlinks(l.Root)
+	if err != nil {
+		l.mu.Lock()
+		l.invalidPaths++
+		l.mu.Unlock()
+		return
+	}
+	if !filepath.IsAbs(sourcePath) {
+		sourcePath = filepath.Join(root, sourcePath)
+	}
+	sourcePath, err = filepath.EvalSymlinks(sourcePath)
+	if err != nil {
+		l.mu.Lock()
+		l.invalidPaths++
+		l.mu.Unlock()
+		return
+	}
+	relative, err := filepath.Rel(root, sourcePath)
+	if err != nil || relative == "." || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		l.mu.Lock()
+		l.invalidPaths++
+		l.mu.Unlock()
+		return
+	}
+	relative = filepath.ToSlash(filepath.Clean(relative))
+	if ruleID == "" || len(ruleID) > factoryLedgerMaxRule || len(relative) > factoryLedgerMaxPath || strings.ContainsAny(ruleID, "\r\n\x00") || strings.ContainsAny(relative, "\r\n\x00") || !factoryLedgerDispositions[disposition] {
+		l.mu.Lock()
+		l.invalidPaths++
+		l.mu.Unlock()
+		return
+	}
+	key := relative + "\x00" + ruleID
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	row := l.rows[key]
+	if row == nil {
+		rowCost := len(relative) + len(ruleID) + 96
+		if len(l.rows) >= factoryLedgerMaxRows || l.rowBytes+rowCost > factoryLedgerMaxBytes/2 {
+			l.overflow = true
+			return
+		}
+		row = &factoryRuleRow{Path: relative, RuleID: ruleID, Counts: make(map[string]uint64)}
+		l.rows[key] = row
+		l.rowBytes += rowCost
+	}
+	if row.Counts[disposition] == math.MaxUint64 {
+		l.overflow = true
+		return
+	}
+	row.Counts[disposition]++
+}
+
+// Write emits deterministic bounded ledger bytes atomically after the scan.
+func (l *FactoryRuleLedger) Write(configPath string, complete bool) error {
+	if l == nil || l.Path == "" {
+		return errors.New("factory rule ledger path missing")
+	}
+	if !factoryLedgerDigest.MatchString(l.SourceSHA256) {
+		return errors.New("factory rule ledger source identity invalid")
+	}
+	config, err := os.ReadFile(configPath)
+	if err != nil {
+		return err
+	}
+	hash := sha256.Sum256(config)
+	l.mu.Lock()
+	rows := make([]*factoryRuleRow, 0, len(l.rows))
+	for _, row := range l.rows {
+		counts := make(map[string]uint64, len(row.Counts))
+		for disposition, count := range row.Counts {
+			counts[disposition] = count
+		}
+		rows = append(rows, &factoryRuleRow{Path: row.Path, RuleID: row.RuleID, Counts: counts})
+	}
+	root, err := filepath.EvalSymlinks(l.Root)
+	if err != nil {
+		l.mu.Unlock()
+		return err
+	}
+	overflow := l.overflow
+	invalidPaths := l.invalidPaths
+	l.mu.Unlock()
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].Path != rows[j].Path {
+			return rows[i].Path < rows[j].Path
+		}
+		return rows[i].RuleID < rows[j].RuleID
+	})
+	rootHash := sha256.Sum256([]byte(filepath.Clean(root)))
+	doc := factoryRuleDocument{Schema: "gitleaks.factory-rule-ledger.v1", RootSHA256: hex.EncodeToString(rootHash[:]), SourceIdentityKind: "adapter_candidate_sha256", SourceSHA256: l.SourceSHA256, ConfigSHA256: hex.EncodeToString(hash[:]), PrefilterBypassed: true, Complete: complete && !overflow && invalidPaths == 0, Overflow: overflow, InvalidPaths: invalidPaths, Rows: rows}
+	data, err := json.Marshal(doc)
+	if err != nil {
+		return err
+	}
+	if len(data) > factoryLedgerMaxBytes {
+		return errors.New("factory rule ledger exceeds byte budget")
+	}
+	rootAbs, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return err
+	}
+	outputParent, err := filepath.EvalSymlinks(filepath.Dir(l.Path))
+	if err != nil {
+		return err
+	}
+	outputAbs := filepath.Join(outputParent, filepath.Base(l.Path))
+	if relative, relErr := filepath.Rel(rootAbs, outputAbs); relErr != nil || relative == "." || (relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator))) {
+		return errors.New("factory rule ledger destination overlaps source root")
+	}
+	if _, err := os.Lstat(outputAbs); err == nil {
+		return errors.New("factory rule ledger destination already exists")
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(l.Path), ".gitleaks-ledger-*")
+	if err != nil {
+		return err
+	}
+	name := tmp.Name()
+	defer os.Remove(name)
+	if _, err = tmp.Write(data); err != nil {
+		_ = tmp.Close()
+		return err
+	}
+	if err = tmp.Sync(); err != nil {
+		_ = tmp.Close()
+		return err
+	}
+	if err = tmp.Close(); err != nil {
+		return err
+	}
+	if err := os.Link(name, outputAbs); err != nil {
+		return err
+	}
+	return nil
+}
