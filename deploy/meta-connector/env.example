# Replace every example URL with an operator-controlled HTTPS endpoint.
# Keep this file non-secret; configure values in the deployment secret manager.
FACTORY_META_DATABASE=/data/meta-connector.sqlite
# For Vercel, use an independent PostgreSQL service instead of SQLite, e.g.
# FACTORY_META_DATABASE=postgresql://... (set only in Vercel secret settings)
FACTORY_META_PUBLIC_BASE_URL=https://connector.example.com/api
FACTORY_META_OIDC_ISSUER=https://identity.example.com/
FACTORY_META_OIDC_AUDIENCE=code-factory-meta-connector
FACTORY_META_JWKS_URL=https://identity.example.com/.well-known/jwks.json
FACTORY_META_AUTHORIZATION_URL=https://identity.example.com/oauth/authorize
FACTORY_META_TOKEN_URL=https://identity.example.com/oauth/token

# Dedicated Clerk OAuth alternative (do not mix with WizeMe's Clerk app):
# FACTORY_META_OIDC_PROVIDER=clerk
# FACTORY_META_TENANT_ID=code-factory
# FACTORY_META_OIDC_ISSUER=https://dedicated-instance.clerk.accounts.dev
# FACTORY_META_CLERK_CLIENT_ID=... (deployment secret manager only)
# FACTORY_META_CLERK_CLIENT_SECRET=... (deployment secret manager only)
# The generic profile's OIDC_AUDIENCE and JWKS_URL are not used by Clerk.
# Clerk OAuth token introspection checks active status, client ID and scope.

# OAuth provider configuration, not application environment variables:
# - Authorization code with PKCE S256; use Meta's assigned redirect URI.
# - Publish cf.audit.read and cf.audit.write; cf.audit.link is generic OIDC only.
# - Generic OIDC: issue RS256 JWT access tokens with iss, aud, sub, tenant_id, jti,
#   groups (array of strings), scope, iat, exp; maximum lifetime 900 seconds.
# - Generic OIDC: include auth_time on fresh relink grants.
# - Configure refresh-token rotation
#   and revocation at the provider. Never put OAuth client secrets here.
# - Restrict Meta-exposed tools to cf.audit.read endpoints in onboarding.
